# Dependencies
node_modules/

# Local tunnel tool (54MB binary — not part of the app)
cloudflared.exe

# Secrets — never commit real keys
.env
.env.local
.env.*.local

# Firebase web config: a null stub is committed (no secrets — the web apiKey is
# public). Replace its contents with your project config to enable Google login.

# Database — holds user records + session secret
/data/

# Vercel
.vercel/

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Swin2SR was benchmarked for the on-device upscaler and lost: 17.6s per 128px tile in-browser
# (~19 minutes per picture) against ESPCN's 60ms. Kept locally for reference, never shipped -
# 21 MB of dead weight would live in git history forever.
models/swin2sr-x2-q8.onnx
