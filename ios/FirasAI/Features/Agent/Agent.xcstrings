    "agent.hero.detail" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يخطط وينفّذ ويراجع عمله، ثم يسلّمك النتيجة والملفات. تستمر المهمة في السحابة حتى لو غادرت التطبيق." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "It plans, executes, reviews its work, and delivers the result and files. The mission keeps running in the cloud if you leave the app." } } } },
